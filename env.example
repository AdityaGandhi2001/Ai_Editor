LLM_API_KEY=
LLM_API_BASE=https://api.groq.com/openai/v1
LLM_MODEL_NAME=groq/openai/gpt-oss-120b

# If you received the key via the challenge email, use the proxy instead:
# LLM_API_BASE="https://recllm.brahmastra.tech/"
# LLM_MODEL_NAME=openai/gpt-oss-120b

# ---- Optional tuning (defaults shown) ----
# RECTIFIER_WORKERS=4            # parallel articles
# RECTIFIER_FIX_EFFORT=medium     # gpt-oss reasoning effort for the fix pass
# RECTIFIER_TIER1=1             # deterministically apply clean, unambiguous annotation fixes (0 tokens) before the LLM
# RECTIFIER_RECALL=1            # careful recall: catch real unflagged number errors (on by default); set 0 to match the conservative human references
# RECTIFIER_VERIFY=0             # 1 = run the extra conservative verify pass
# RECTIFIER_VERIFY_EFFORT=medium
# RECTIFIER_MAX_RUN_USD=0.80     # hard per-run spend cap (estimated, conservative prices)
# RECTIFIER_MIN_REMAINING_USD=0.50 # stop if proxy reports less than this left
# RECTIFIER_MAX_TOKENS=12000
# RECTIFIER_NO_CACHE=            # set to 1 to bypass the on-disk response cache
